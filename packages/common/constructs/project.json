{
  "name": "@aws-ocr-vision-lab/common-constructs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/constructs/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        "@aws-ocr-vision-lab/frontend:build"
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/common/constructs/tsc"],
      "options": {
        "commands": [
          "tsc --build tsconfig.lib.json",
          "mkdir -p ../../../dist/packages/common/constructs/tsc/src/core/assets && cp src/core/assets/logo.png ../../../dist/packages/common/constructs/tsc/src/core/assets/logo.png"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/packages/common/constructs"
      }
    }
  },
  "metadata": {
    "generator": "ts#project"
  }
}
